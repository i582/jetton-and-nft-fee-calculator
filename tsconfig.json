{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "tools/**/*.ts",
    "tests/**/*.ts",
    "jetton-calculator.ts",
    "nft-calculator.ts",
    "fees.ts"
  ]
}
